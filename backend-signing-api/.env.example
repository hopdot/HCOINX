# RPC endpoint (Alchemy, Infura, or public)
RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Signing wallet private key (NEVER the Gnosis Safe key — use a dedicated hot wallet)
PRIVATE_KEY=0xYOUR_SIGNING_WALLET_PRIVATE_KEY

# Deployed HCOINXRewards contract address
REWARDS_ADDRESS=0xYOUR_REWARDS_CONTRACT_ADDRESS

# Server port
PORT=3001
